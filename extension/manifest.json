{
  "manifest_version": 3,
  "name": "Em Dash Hider",
  "version": "0.1.0",
  "description": "Replaces em dashes in the text of web pages.",
  "minimum_chrome_version": "119",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Em Dash Hider",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "permissions": ["storage", "activeTab"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/replace.js", "lib/walk.js", "lib/observe.js", "lib/settings.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ]
}
